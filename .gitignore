# .ROOT version-control policy: Git tracks operating documents and source;
# Google Drive backs up the full local vault, including binary/reference material.

# Never version private material or immutable/raw source collections.
88-JOURNAL/
**/raw/
02-LIBRARY/.raw ARCHIVE/
77-INBOX/
99-ARCHIVE/

# Local application state, caches, and generated/transient content.
.obsidian/
.folder-icons/
.tmp.drivedownload/
.tmp.driveupload/
tmp/
Clippings/
desktop.ini
Thumbs.db

# Keep the project Codex policy, but not local Codex state or credentials.
.codex/*
!.codex/config.toml
**/auth.json
**/.env
**/.env.*
!**/.env.example

# Dependency/build artifacts.
**/__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# Project folders that are their own independent local git repo, not part
# of the vault's history (see the project's own Docs\README.md for why).
02-LIBRARY/.PROJECTS/MCP_Bootcamp/

# Large binary/reference material belongs in the Drive backup, not Git history.
*.pdf
*.docx
*.xlsx
*.xls
*.xlsm
*.pptx
*.zip
*.7z
*.db
*.sqlite
*.sqlite3
*.h5p
*.one
*.onetoc2
*.mp3
*.mp4
*.mov
*.png
*.jpg
*.jpeg
*.gif
.DS_Store
**/.idea/

# Machine-specific Claude settings. This rule also exists in the Windows global
# ignore, but WSL git has a different HOME and cannot see that file — and a
# .git/info/exclude entry does not survive a clone. Tracked here so the
# safeguard is recoverable in any checkout (added 2026-08-10, flag #92).
**/.claude/settings.local.json

# Vendored language runtimes. Install these system-wide; never commit them.
# A 372MB Oracle JDK landed here by accident on 2026-08-10 and blocked the
# push (GitHub rejects any file over 100MB; its lib/modules is 140MB).
**/oracleJdk-*/
**/jdk-*/
**/jre-*/
